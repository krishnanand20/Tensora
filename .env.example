# Copy to .env for local overrides. Never commit .env.
# Keep comments on their own lines: the Makefile includes this file.

TENSORA_ENV=dev
TENSORA_HTTP_ADDR=127.0.0.1:8080
TENSORA_LOG_LEVEL=info
# Optional: also append every log line to this file (created with owner-only permissions).
TENSORA_LOG_FILE=

# Empty = in-memory store (make dev only). sqlite:<path> keeps everything in one file, readable by its
# owner only, in a directory other users can't write to (Solo and Lab, ADR-0012; migrated automatically
# when opened). Use an absolute path for services: their working directory is usually /. A postgres:// URL selects
# Postgres (make dev-pg, Datacenter); run `tensora migrate` first.
TENSORA_DATABASE_URL=

# Relative to controlplane/ when running locally.
TENSORA_CATALOG_PATH=../images/catalog.yaml

# local | oidc | dev. local: built-in accounts and API tokens (Solo and Lab; create the owner with
# `tensora setup`). oidc: an identity provider (Datacenter). dev trusts X-Dev-Tenant / X-Dev-User
# headers and is refused unless TENSORA_ENV=dev.
TENSORA_AUTH_MODE=dev
# Local auth: passwords and session cookies cross only HTTPS or this machine. Behind a reverse proxy
# that terminates HTTPS, list it here (addresses or CIDR ranges, comma-separated) so its
# X-Forwarded-Proto and X-Forwarded-For are believed. TENSORA_INSECURE_HTTP=true also allows plain
# HTTP from other machines: only on a network you trust.
TENSORA_TRUSTED_PROXIES=
TENSORA_INSECURE_HTTP=false
TENSORA_OIDC_ISSUER=
TENSORA_OIDC_AUDIENCE=tensora-api
TENSORA_OIDC_TENANT_CLAIM=tensora_tenant

# fake | kubernetes
TENSORA_CLUSTER_BACKEND=fake
TENSORA_FAKE_CAPACITY=l40s-48gb=4,a100-80gb=2
TENSORA_UNTRUSTED_RUNTIME_CLASS=kata-qemu-nvidia-gpu
TENSORA_STORAGE_CLASS=tensora-block
TENSORA_IMAGES_NAMESPACE=tensora-images

# The one region this process's controller reconciles (ADR-0009). Must be in the catalog's regions.
TENSORA_REGION=local

# Planned, not read by the code yet:
#   ADR-0013: TENSORA_CLUSTER_BACKEND=agent                       (node agents on Macs and Linux)

TENSORA_CONTROLLER_INTERVAL=5s
TENSORA_METERING_INTERVAL=5m

# Dashboard (web/): tenant used for dev-mode auth headers.
VITE_DEV_TENANT=acme

# CLI client (tensora workloads | events <id> | export <id>). Not used by the server.
#   TENSORA_API_URL     default http://127.0.0.1:8080
#   TENSORA_TOKEN       an API token (tsk_…, from the dashboard's API tokens page) or an OIDC token; never commit one
#   TENSORA_DEV_TENANT  tenant slug sent as X-Dev-Tenant (dev mode)
#   TENSORA_INSECURE_HTTP=true  allow sending TENSORA_TOKEN over plain http:// to another machine (off by default;
#                               the server reads the same setting, above)
