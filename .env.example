# Copy to .env for local overrides. Never commit .env.
# Keep comments on their own lines: the Makefile includes this file.

TENSORA_ENV=dev
TENSORA_HTTP_ADDR=127.0.0.1:8080
TENSORA_LOG_LEVEL=info

# Empty = in-memory store (make dev). Set to a Postgres URL for make dev-pg / production.
TENSORA_DATABASE_URL=

# Relative to controlplane/ when running locally.
TENSORA_CATALOG_PATH=../images/catalog.yaml

# dev | oidc. dev trusts X-Dev-Tenant / X-Dev-User headers and is refused when TENSORA_ENV=production.
TENSORA_AUTH_MODE=dev
TENSORA_OIDC_ISSUER=
TENSORA_OIDC_AUDIENCE=tensora-api
TENSORA_OIDC_TENANT_CLAIM=tensora_tenant

# fake | kubernetes
TENSORA_CLUSTER_BACKEND=fake
TENSORA_FAKE_CAPACITY=l40s-48gb=4,a100-80gb=2
TENSORA_UNTRUSTED_RUNTIME_CLASS=kata-qemu-nvidia-gpu
TENSORA_STORAGE_CLASS=tensora-block
TENSORA_IMAGES_NAMESPACE=tensora-images

TENSORA_CONTROLLER_INTERVAL=5s
TENSORA_METERING_INTERVAL=5m

# Dashboard (web/): tenant used for dev-mode auth headers.
VITE_DEV_TENANT=acme
