{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make test-cp:*)",
      "Bash(make test-ml:*)",
      "Bash(make test-web:*)",
      "Bash(make fmt:*)",
      "Bash(make deploy-check:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(kubeconform:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Edit(/.claude/skills/add-api-resource/**)",
      "Edit(/.claude/skills/add-platform-component/**)",
      "Bash(python3 -)",
      "Bash(grep -rn --include='*.md' -iE 'small GPU cloud|multiple regions|Razorpay or Stripe|\\\\.ep\\\\.<domain>|<id>\\\\.ep\\\\.|MIG.*Phase 4|Phase 4.*MIG|\\\\| — \\\\|$|Maps to' .)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/kubeconfig*)",
      "Read(**/*.kubeconfig)",
      "Read(**/secrets/**)",
      "Read(infra/ansible/group_vars/all/vault.yml)"
    ],
    "ask": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helmfile apply:*)",
      "Bash(helmfile sync:*)",
      "Bash(helmfile destroy:*)",
      "Bash(ansible-playbook:*)",
      "Bash(virtctl:*)",
      "Bash(docker push:*)",
      "Bash(git push:*)"
    ]
  }
}
